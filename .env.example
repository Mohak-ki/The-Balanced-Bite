# Copy this file to .env and fill in real values. Never commit .env.

# Server
PORT=5000
NODE_ENV=development
# Public URL of the front-end, used for CORS and Stripe redirects.
CLIENT_URL=http://localhost:5000

# Auth — REQUIRED. Use a long random value, e.g. `openssl rand -hex 32`.
JWT_SECRET=
JWT_EXPIRES_IN=2h

# MySQL
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=balanced_bite

# MongoDB (only used by the /api/mern meal-planner module)
MONGO_URI=mongodb://127.0.0.1:27017/balanced_bite_mern

# Stripe
STRIPE_SECRET_KEY=
